rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function roomExists(roomCode) {
      return exists(roomPath(roomCode));
    }

    function roomData(roomCode) {
      return get(roomPath(roomCode)).data;
    }

    function roomDataAfter(roomCode) {
      return getAfter(roomPath(roomCode)).data;
    }

    function isRoomDm(roomCode) {
      return signedIn()
        && roomExists(roomCode)
        && roomData(roomCode).dmUid == request.auth.uid;
    }

    function membershipPath(roomCode, uid) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(uid);
    }

    function tokenPath(roomCode, tokenId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/tokens/$(tokenId);
    }

    function tokenIsShared(data) {
      return data.get('visibility', 'shared') == 'shared';
    }

    function tokenIsDmOnly(data) {
      return data.get('visibility', '') == 'dm';
    }

    function scenePath(roomCode, sceneId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/scenes/$(sceneId);
    }

    function floorPath(roomCode, sceneId, floorId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/scenes/$(sceneId)/floors/$(floorId);
    }

    function floorConnectionPath(roomCode, sceneId, connectionId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/scenes/$(sceneId)/connections/$(connectionId);
    }

    function fogSettingsPath(roomCode, mapId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/fogSettings/$(mapId);
    }

    function combatTurnPath(roomCode, tokenId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/combatTurns/$(tokenId);
    }

    function characterPath(roomCode, characterId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/characters/$(characterId);
    }

    function ownsRoomToken(roomCode, tokenId) {
      return signedIn()
        && exists(tokenPath(roomCode, tokenId))
        && get(tokenPath(roomCode, tokenId)).data.get('ownerUid', '')
          == request.auth.uid;
    }

    function tokenMovementFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'x',
        'y',
        'movedAtMillis',
        'updatedAtMillis',
        'updatedAt'
      ]);
    }

    function tokenFloorTransitionFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'sceneId',
        'floorId',
        'x',
        'y',
        'elevation',
        'elevationFeet',
        'heightAboveFloor',
        'lastFloorConnectionId',
        'floorChangedAtMillis',
        'movedAtMillis',
        'updatedAtMillis',
        'updatedAt'
      ]);
    }

    function validPlayerFloorTransitionDocuments(roomCode, sceneId, connectionId, oldFloorId, nextFloorId) {
      let connection = get(floorConnectionPath(roomCode, sceneId, connectionId)).data;
      let source = connection.get('source', {});
      let destination = connection.get('destination', {});
      let routeMatches = (
          source.get('floorId', '') == oldFloorId
          && destination.get('floorId', '') == nextFloorId
          && request.resource.data.x == destination.get('x', -1)
          && request.resource.data.y == destination.get('y', -1)
        ) || (
          connection.get('bidirectional', false) == true
          && destination.get('floorId', '') == oldFloorId
          && source.get('floorId', '') == nextFloorId
          && request.resource.data.x == source.get('x', -1)
          && request.resource.data.y == source.get('y', -1)
        );
      let nextFloor = get(floorPath(roomCode, sceneId, nextFloorId)).data;
      return connection.get('sceneId', '') == sceneId
        && connection.get('roomCode', '') == roomCode
        && connection.get('allowPlayers', false) == true
        && routeMatches
        && request.resource.data.get('heightAboveFloor', 1001) >= -1000
        && request.resource.data.get('heightAboveFloor', -1001) <= 1000
        && request.resource.data.get('elevation', 1001)
          == nextFloor.get('baseElevation', 0)
            + request.resource.data.get('heightAboveFloor', 0)
        && request.resource.data.get('elevationFeet', 1001)
          == request.resource.data.get('elevation', -1001);
    }

    function validPlayerFloorTransition(roomCode, tokenId) {
      let sceneId = request.resource.data.get('sceneId', '');
      let connectionId = request.resource.data.get('lastFloorConnectionId', '');
      let oldFloorId = resource.data.get('floorId', '');
      let nextFloorId = request.resource.data.get('floorId', '');
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && roomData(roomCode).get('initiativeState', {}).get('combatActive', false) != true
        && tokenFloorTransitionFieldsOnly()
        && sceneId != ''
        && connectionId != ''
        && oldFloorId != ''
        && nextFloorId != ''
        && exists(scenePath(roomCode, sceneId))
        && exists(floorConnectionPath(roomCode, sceneId, connectionId))
        && exists(floorPath(roomCode, sceneId, nextFloorId))
        && validPlayerFloorTransitionDocuments(
          roomCode, sceneId, connectionId, oldFloorId, nextFloorId
        );
    }

    function linkedCharacterSyncFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'imageUrl',
        'publicId',
        'sizeCategory',
        'creatureSize',
        'size',
        'armorClass',
        'ac',
        'dexterity',
        'initiativeBonus',
        'movementSpeed',
        'baseSpeed',
        'movementSpeeds',
        'ownerUid',
        'currentHp',
        'maxHp',
        'hp',
        'hpAuthority',
        'linkedCharacterId',
        'sheetId',
        'sourceType',
        'linkedCharacterRevision',
        'linkedCharacter',
        'updatedAtMillis',
        'updatedAt'
      ]);
    }

    function validLinkedCharacterTokenSync(roomCode) {
      let characterId = resource.data.get('linkedCharacterId', '');
      let character = get(characterPath(roomCode, characterId)).data;
      let combat = character.get('combat', {});
      let identity = character.get('identity', {});
      let baseSpeed = combat.get('baseSpeed', {});
      return characterId != ''
        && exists(characterPath(roomCode, characterId))
        && linkedCharacterSyncFieldsOnly()
        && resource.data.get('sourceType', '') == 'character'
        && request.resource.data.get('sourceType', '') == 'character'
        && request.resource.data.get('linkedCharacterId', '') == characterId
        && request.resource.data.get('sheetId', '') == characterId
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && character.get('ownerUid', '') == request.auth.uid
        && character.get('roomCode', '') == roomCode
        && request.resource.data.get('linkedCharacterRevision', 0)
          == character.get('revision', -1)
        && request.resource.data.get('linkedCharacterRevision', 0)
          > resource.data.get('linkedCharacterRevision', 0)
        && request.resource.data.get('hpAuthority', '') == 'character'
        && request.resource.data.get('name', '') == identity.get('name', '')
        && request.resource.data.get('currentHp', -1)
          == combat.get('currentHp', -2)
        && request.resource.data.get('maxHp', -1)
          == combat.get('maxHp', -2)
        && request.resource.data.get('armorClass', -1)
          == combat.get('armorClass', -2)
        && request.resource.data.get('ac', -1)
          == combat.get('armorClass', -2)
        && request.resource.data.get('movementSpeed', -1)
          == baseSpeed.get('walk', -2)
        && request.resource.data.get('baseSpeed', -1)
          == baseSpeed.get('walk', -2)
        && request.resource.data.get('movementSpeeds', {}).get('walk', -1)
          == baseSpeed.get('walk', -2)
        && request.resource.data.get('linkedCharacter', {}).get('id', '')
          == characterId
        && request.resource.data.get('linkedCharacter', {}).get('ownerUid', '')
          == request.auth.uid;
    }

    function tokenIsCurrentOrExploring(roomCode, tokenId) {
      return roomData(roomCode)
          .get('initiativeState', {})
          .get('combatActive', false) != true
        || roomData(roomCode)
          .get('initiativeState', {})
          .get('currentCombatantId', '') == tokenId;
    }

    function trackedTokenMoveIsConfirmed(roomCode, tokenId) {
      let room = roomData(roomCode);
      let initiative = room.get('initiativeState', {});
      let previous = room.get('movementState', {});
      let movement = getAfter(roomPath(roomCode)).data
        .get('movementState', {});
      let position = movement.get('lastConfirmedPosition', {});
      return initiative.get('combatActive', false) != true
        || (
          initiative.get('currentCombatantId', '') == tokenId
          && movement.get('activeTokenId', '') == tokenId
          && movement.get('movementTurnKey', '')
            == previous.get('movementTurnKey', '')
          && movement.get('movementRemaining', 101)
            < previous.get('movementRemaining', 0)
          && movement.get('movementSpent', -1)
            > previous.get('movementSpent', 100)
          && request.resource.data.x == position.get('x', -1)
          && request.resource.data.y == position.get('y', -1)
        );
    }

    function validPlayerMovementRoomUpdate(roomCode) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let movement = request.resource.data.get('movementState', {});
      let previous = resource.data.get('movementState', {});
      let initiative = resource.data.get('initiativeState', {});
      let tokenId = movement.get('activeTokenId', '');
      let position = movement.get('lastConfirmedPosition', {});
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && changed.hasOnly(['movementState', 'updatedAt'])
        && initiative.get('combatActive', false) == true
        && tokenId == initiative.get('currentCombatantId', '')
        && ownsRoomToken(roomCode, tokenId)
        && movement.get('combatActive', false) == true
        && movement.get('movementTurnKey', '')
          == previous.get('movementTurnKey', '')
        && movement.get('activeTokenId', '')
          == previous.get('activeTokenId', '')
        && movement.get('baseSpeed', -1) >= 0
        && movement.get('baseSpeed', 201) <= 200
        && movement.get('baseSpeed', -1)
          == previous.get('baseSpeed', -2)
        && movement.get('movementMode', 'walk')
          == previous.get('movementMode', 'walk')
        && movement.get('movementModeBaseSpeed', movement.get('baseSpeed', 0))
          == previous.get('movementModeBaseSpeed', previous.get('baseSpeed', 0))
        && movement.get('dashCount', 0)
          == previous.get('dashCount', 0)
        && movement.get('movementRemaining', -1) >= 0
        && movement.get('movementRemaining', 101)
          <= movement.get('baseSpeed', 0)
        && movement.get('movementRemaining', 101)
          < previous.get('movementRemaining', 0)
        && movement.get('movementSpent', -1) >= 0
        && movement.get('movementSpent', -1)
          > previous.get('movementSpent', 100)
        && previous.get('movementRemaining', 0)
          - movement.get('movementRemaining', 0)
          == movement.get('movementSpent', 0)
            - previous.get('movementSpent', 0)
        && movement.get('movementRemaining', 0)
          + movement.get('movementSpent', 0)
          == movement.get('baseSpeed', -1)
        && movement.get('lastMoveForced', true) == false
        && movement.get('movementOverage', -1) == 0
        && getAfter(tokenPath(roomCode, tokenId)).data.x
          == position.get('x', -1)
        && getAfter(tokenPath(roomCode, tokenId)).data.y
          == position.get('y', -1);
    }

    function tokenMovementModeSpeed(roomCode, tokenId, mode) {
      let token = get(tokenPath(roomCode, tokenId)).data;
      return mode == 'walk'
        ? token.get('movementSpeeds', {}).get('walk', token.get('movementSpeed', token.get('baseSpeed', 0)))
        : token.get('movementSpeeds', {}).get(mode, 0);
    }

    function validPlayerMovementModeRoomUpdate(roomCode) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let movement = request.resource.data.get('movementState', {});
      let previous = resource.data.get('movementState', {});
      let initiative = resource.data.get('initiativeState', {});
      let tokenId = movement.get('activeTokenId', '');
      let mode = movement.get('movementMode', '');
      let speed = tokenMovementModeSpeed(roomCode, tokenId, mode);
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && changed.hasOnly(['movementState', 'updatedAt'])
        && initiative.get('combatActive', false) == true
        && tokenId == initiative.get('currentCombatantId', '')
        && ownsRoomToken(roomCode, tokenId)
        && movement.get('movementTurnKey', '') == previous.get('movementTurnKey', '')
        && movement.get('activeTokenId', '') == previous.get('activeTokenId', '')
        && mode in ['walk', 'fly', 'swim', 'climb', 'burrow']
        && speed > 0
        && speed <= 100
        && movement.get('movementModeBaseSpeed', -1) == speed
        && movement.get('dashCount', -1) == previous.get('dashCount', 0)
        && movement.get('movementSpent', -1) == previous.get('movementSpent', -2)
        && movement.get('baseSpeed', -1)
          == speed * (1 + movement.get('dashCount', 0))
        && movement.get('movementRemaining', -1)
          == movement.get('baseSpeed', 0) - movement.get('movementSpent', 0)
        && movement.get('lastConfirmedPosition', {})
          == previous.get('lastConfirmedPosition', {});
    }

    function validPlayerDashRoomUpdate(roomCode) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let movement = request.resource.data.get('movementState', {});
      let previous = resource.data.get('movementState', {});
      let initiative = resource.data.get('initiativeState', {});
      let tokenId = movement.get('activeTokenId', '');
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && changed.hasOnly(['movementState', 'updatedAt'])
        && initiative.get('combatActive', false) == true
        && tokenId == initiative.get('currentCombatantId', '')
        && ownsRoomToken(roomCode, tokenId)
        && movement.get('movementTurnKey', '') == previous.get('movementTurnKey', '')
        && movement.get('movementMode', 'walk') == previous.get('movementMode', 'walk')
        && movement.get('movementModeBaseSpeed', -1)
          == previous.get('movementModeBaseSpeed', -2)
        && previous.get('dashCount', 0) == 0
        && movement.get('dashCount', -1) == 1
        && movement.get('movementSpent', -1) == previous.get('movementSpent', -2)
        && movement.get('baseSpeed', -1)
          == previous.get('baseSpeed', 0) + previous.get('movementModeBaseSpeed', 0)
        && movement.get('movementRemaining', -1)
          == previous.get('movementRemaining', 0) + previous.get('movementModeBaseSpeed', 0)
        && getAfter(combatTurnPath(roomCode, tokenId)).data.get('lastCommand', '') == 'dash';
    }

    function validPlayerTurnAdvanceRequest(roomCode) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let initiative = resource.data.get('initiativeState', {});
      let advance = request.resource.data.get('turnAdvanceRequest', {});
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && changed.hasOnly(['turnAdvanceRequest', 'updatedAt'])
        && advance.keys().hasOnly([
          'requestId', 'tokenId', 'requestedByUid', 'turnCounter', 'requestedAtMillis'
        ])
        && advance.get('requestId', '') is string
        && advance.get('requestId', '').size() > 0
        && advance.get('tokenId', '') == initiative.get('currentCombatantId', '')
        && advance.get('requestedByUid', '') == request.auth.uid
        && advance.get('turnCounter', -1) == initiative.get('turnCounter', -2)
        && ownsRoomToken(roomCode, advance.get('tokenId', ''));
    }

    function validCombatTurnShape(roomCode, tokenId) {
      let turn = request.resource.data;
      let initiative = roomDataAfter(roomCode).get('initiativeState', {});
      let currentTurn = initiative.get('currentCombatantId', '') == tokenId
        && turn.get('roundNumber', -1) == initiative.get('roundNumber', -2)
        && turn.get('turnCounter', -1) == initiative.get('turnCounter', -2);
      let offTurnReaction = initiative.get('currentCombatantId', '') != tokenId
        && turn.get('lastResource', '') == 'reaction'
        && turn.get('reactionAvailable', true) == false
        && turn.get('roundNumber', -1) <= initiative.get('roundNumber', -2)
        && turn.get('turnCounter', -1) <= initiative.get('turnCounter', -2);
      return turn.keys().hasOnly([
          'schemaVersion', 'tokenId', 'combatActive', 'turnKey',
          'roundNumber', 'turnCounter', 'actionsRemaining',
          'bonusActionsRemaining', 'reactionAvailable',
          'attackActionStarted', 'attacksRemaining', 'actionSurgeUsed',
          'dashUsed', 'disengaged', 'dodging', 'hidden', 'helping',
          'lastCommand', 'lastResource', 'lastCommandByUid',
          'revision', 'updatedAtMillis', 'updatedAt'
        ])
        && turn.get('schemaVersion', 0) == 1
        && turn.get('tokenId', '') == tokenId
        && turn.get('combatActive', false) == true
        && initiative.get('combatActive', false) == true
        && (currentTurn || offTurnReaction)
        && turn.get('turnKey', '') is string
        && turn.get('turnKey', '').size() > 0
        && turn.get('turnKey', '').size() <= 128
        && turn.get('actionsRemaining', -1) >= 0
        && turn.get('actionsRemaining', 3) <= 2
        && turn.get('bonusActionsRemaining', -1) >= 0
        && turn.get('bonusActionsRemaining', 2) <= 1
        && turn.get('reactionAvailable', null) is bool
        && turn.get('attackActionStarted', null) is bool
        && turn.get('attacksRemaining', -1) >= 0
        && turn.get('attacksRemaining', 21) <= 20
        && turn.get('actionSurgeUsed', null) is bool
        && turn.get('dashUsed', null) is bool
        && turn.get('disengaged', null) is bool
        && turn.get('dodging', null) is bool
        && turn.get('hidden', null) is bool
        && turn.get('helping', null) is bool
        && turn.get('lastResource', '') in ['action', 'bonus', 'reaction', 'free']
        && turn.get('lastCommandByUid', '') == request.auth.uid;
    }

    function validFreshCombatTurnOutcome() {
      let turn = request.resource.data;
      return (
          turn.get('lastCommand', '') == 'action-surge'
          && turn.get('lastResource', '') == 'free'
          && turn.get('actionsRemaining', -1) == 2
          && turn.get('actionSurgeUsed', false) == true
        ) || (
          turn.get('lastResource', '') == 'action'
          && turn.get('actionsRemaining', -1) == 0
          && turn.get('bonusActionsRemaining', -1) == 1
          && turn.get('reactionAvailable', false) == true
        ) || (
          turn.get('lastResource', '') == 'bonus'
          && turn.get('actionsRemaining', -1) == 1
          && turn.get('bonusActionsRemaining', -1) == 0
          && turn.get('reactionAvailable', false) == true
        ) || (
          turn.get('lastResource', '') == 'reaction'
          && turn.get('actionsRemaining', -1) == 1
          && turn.get('bonusActionsRemaining', -1) == 1
          && turn.get('reactionAvailable', true) == false
        ) || (
          turn.get('lastResource', '') == 'free'
          && turn.get('actionsRemaining', -1) == 1
          && turn.get('bonusActionsRemaining', -1) == 1
          && turn.get('reactionAvailable', false) == true
        );
    }

    function validFreshOffTurnReactionOutcome(roomCode, tokenId) {
      let turn = request.resource.data;
      let initiative = roomDataAfter(roomCode).get('initiativeState', {});
      return initiative.get('currentCombatantId', '') != tokenId
        && turn.get('lastResource', '') == 'reaction'
        && turn.get('actionsRemaining', -1) == 0
        && turn.get('bonusActionsRemaining', -1) == 0
        && turn.get('reactionAvailable', true) == false
        && turn.get('attackActionStarted', true) == false
        && turn.get('attacksRemaining', -1) == 0
        && turn.get('actionSurgeUsed', true) == false
        && turn.get('dashUsed', true) == false
        && turn.get('disengaged', true) == false
        && turn.get('dodging', true) == false
        && turn.get('hidden', true) == false
        && turn.get('helping', true) == false;
    }

    function validSameTurnCombatStep() {
      let turn = request.resource.data;
      let previous = resource.data;
      let command = turn.get('lastCommand', '');
      let paidWith = turn.get('lastResource', '');
      let standardSpend = (
          paidWith == 'action'
          && previous.get('actionsRemaining', 0) > 0
          && turn.get('actionsRemaining', -1) == previous.get('actionsRemaining', 0) - 1
          && turn.get('bonusActionsRemaining', -1) == previous.get('bonusActionsRemaining', -2)
          && turn.get('reactionAvailable', false) == previous.get('reactionAvailable', false)
        ) || (
          paidWith == 'bonus'
          && previous.get('bonusActionsRemaining', 0) > 0
          && turn.get('bonusActionsRemaining', -1) == previous.get('bonusActionsRemaining', 0) - 1
          && turn.get('actionsRemaining', -1) == previous.get('actionsRemaining', -2)
          && turn.get('reactionAvailable', false) == previous.get('reactionAvailable', false)
        ) || (
          paidWith == 'reaction'
          && previous.get('reactionAvailable', false) == true
          && turn.get('reactionAvailable', true) == false
          && turn.get('actionsRemaining', -1) == previous.get('actionsRemaining', -2)
          && turn.get('bonusActionsRemaining', -1) == previous.get('bonusActionsRemaining', -2)
        ) || (
          paidWith == 'free'
          && turn.get('actionsRemaining', -1) == previous.get('actionsRemaining', -2)
          && turn.get('bonusActionsRemaining', -1) == previous.get('bonusActionsRemaining', -2)
          && turn.get('reactionAvailable', false) == previous.get('reactionAvailable', false)
        );
      let extraAttack = command == 'weapon-attack'
        && previous.get('attackActionStarted', false) == true
        && previous.get('attacksRemaining', 0) > 0
        && turn.get('actionsRemaining', -1) == previous.get('actionsRemaining', -2)
        && turn.get('bonusActionsRemaining', -1) == previous.get('bonusActionsRemaining', -2)
        && turn.get('reactionAvailable', false) == previous.get('reactionAvailable', false)
        && turn.get('attacksRemaining', -1) == previous.get('attacksRemaining', 0) - 1;
      let actionSurge = command == 'action-surge'
        && previous.get('actionSurgeUsed', false) == false
        && turn.get('actionSurgeUsed', false) == true
        && turn.get('actionsRemaining', -1) == previous.get('actionsRemaining', 0) + 1
        && turn.get('actionsRemaining', -1) <= 2
        && turn.get('bonusActionsRemaining', -1) == previous.get('bonusActionsRemaining', -2)
        && turn.get('reactionAvailable', false) == previous.get('reactionAvailable', false);
      return (standardSpend || extraAttack || actionSurge)
        && turn.get('revision', -1) == previous.get('revision', 0) + 1
        && (previous.get('actionSurgeUsed', false) == false || turn.get('actionSurgeUsed', false) == true)
        && (previous.get('dashUsed', false) == false || turn.get('dashUsed', false) == true);
    }

    function validOffTurnReactionStep(roomCode, tokenId) {
      let turn = request.resource.data;
      let previous = resource.data;
      let initiative = roomDataAfter(roomCode).get('initiativeState', {});
      let changed = turn.diff(previous).affectedKeys();
      return initiative.get('currentCombatantId', '') != tokenId
        && changed.hasOnly([
          'reactionAvailable', 'lastCommand', 'lastResource',
          'lastCommandByUid', 'revision', 'updatedAtMillis', 'updatedAt'
        ])
        && turn.get('lastResource', '') == 'reaction'
        && previous.get('reactionAvailable', false) == true
        && turn.get('reactionAvailable', true) == false
        && turn.get('revision', -1) == previous.get('revision', 0) + 1;
    }

    function validCombatTurnActor(roomCode, tokenId) {
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && validCombatTurnShape(roomCode, tokenId)
        && (
          isRoomDm(roomCode)
          || ownsRoomToken(roomCode, tokenId)
        );
    }

    function validCombatTurnCreate(roomCode, tokenId) {
      return validCombatTurnActor(roomCode, tokenId)
        && request.resource.data.get('revision', -1) == 1
        && (
          validFreshCombatTurnOutcome()
          || validFreshOffTurnReactionOutcome(roomCode, tokenId)
        );
    }

    function validCombatTurnUpdate(roomCode, tokenId) {
      let previousInitiative = roomData(roomCode).get('initiativeState', {});
      let nextInitiative = roomDataAfter(roomCode).get('initiativeState', {});
      let sameTurn = request.resource.data.get('turnKey', '')
        == resource.data.get('turnKey', '');
      let sameAuthoritativeTurn = resource.data.get('roundNumber', -1)
          == nextInitiative.get('roundNumber', -2)
        && resource.data.get('turnCounter', -1)
          == nextInitiative.get('turnCounter', -2)
        && resource.data.get('tokenId', '')
          == nextInitiative.get('currentCombatantId', '');
      let authoritativeTurnChanged = previousInitiative.get('combatActive', false) != true
        || previousInitiative.get('currentCombatantId', '')
          != nextInitiative.get('currentCombatantId', '')
        || previousInitiative.get('roundNumber', -1)
          != nextInitiative.get('roundNumber', -2)
        || previousInitiative.get('turnCounter', -1)
          != nextInitiative.get('turnCounter', -2);
      let offTurn = nextInitiative.get('currentCombatantId', '') != tokenId;
      return validCombatTurnActor(roomCode, tokenId)
        && (
          offTurn
            ? validOffTurnReactionStep(roomCode, tokenId)
            : authoritativeTurnChanged
                && isRoomDm(roomCode)
                && request.resource.data.get('lastCommand', '') == 'turn-start'
                && request.resource.data.get('revision', -1)
                  == resource.data.get('revision', 0) + 1
                && validFreshCombatTurnOutcome()
              || sameAuthoritativeTurn
                && sameTurn
                && validSameTurnCombatStep()
              || !sameAuthoritativeTurn
                && request.resource.data.get('revision', -1)
                  == resource.data.get('revision', 0) + 1
                && validFreshCombatTurnOutcome()
        );
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && (
          isRoomDm(roomCode)
          || exists(membershipPath(roomCode, request.auth.uid))
        );
    }

    function roomAcceptsWrites(roomCode) {
      return roomExists(roomCode)
        && roomData(roomCode).get('deletingAt', null) == null;
    }

    function deletionLifecycleFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deletionState', 'deletionUpdatedAt'
      ])
        && request.resource.data.get('deletingAt', null)
          == resource.data.get('deletingAt', null);
    }

    function ownsCharacter(data) {
      return signedIn()
        && data.get('ownerUid', '') == request.auth.uid;
    }

    function validPersonalLibraryRevision(userId) {
      let nextRevision = request.resource.data.get('revision', 0);
      return nextRevision is int
        && nextRevision >= 1
        && (
          (
            resource == null
            && nextRevision == 1
          )
          || (
            resource != null
            && resource.data.get('ownerUid', '') == userId
            && nextRevision == resource.data.get('revision', 0) + 1
          )
        );
    }

    function validCharacterWrite(roomCode) {
      return request.resource.data.roomCode == roomCode
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }

    function validDmOwnedWrite(roomCode) {
      return request.resource.data.roomCode == roomCode
        && request.resource.data.ownerUid == roomData(roomCode).dmUid;
    }

    function validGameplayEffect(roomCode, effectId) {
      return request.resource.data.keys().hasOnly([
          'id', 'definitionId', 'name', 'type', 'icon', 'description',
          'roomCode', 'sourceId', 'sourceType', 'targetTokenId',
          'targetCharacterId', 'duration', 'timing', 'modifiers', 'tags',
          'animation', 'createdByUid', 'createdAtMillis', 'updatedAtMillis',
          'updatedAt'
        ])
        && request.resource.data.id == effectId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.definitionId is string
        && request.resource.data.definitionId.size() > 0
        && request.resource.data.definitionId.size() <= 180
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.type in [
          'condition', 'buff', 'debuff', 'other'
        ]
        && request.resource.data.targetTokenId is string
        && request.resource.data.targetTokenId.size() > 0
        && request.resource.data.targetTokenId.size() <= 180
        && request.resource.data.duration is map
        && request.resource.data.timing is map
        && request.resource.data.modifiers is list
        && request.resource.data.modifiers.size() <= 24
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20
        && request.resource.data.animation is map
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function validJournalEntry(roomCode, entryId, visibility) {
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'ownerUid', 'ownerName', 'title', 'category',
          'visibility', 'contentHtml', 'searchText', 'createdAtMillis',
          'updatedAtMillis', 'revision', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == entryId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.visibility == visibility
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.ownerUid.size() <= 180
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 160
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && request.resource.data.contentHtml is string
        && request.resource.data.contentHtml.size() <= 50000
        && request.resource.data.searchText is string
        && request.resource.data.searchText.size() <= 50000
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function validDrawingStroke(roomCode, strokeId, layer) {
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'mapId', 'authorUid', 'authorName', 'layer',
          'tool', 'color', 'size', 'points', 'start', 'end',
          'originalAuthorUid', 'originalAuthorName', 'restoredByUid',
          'createdAtMillis', 'updatedAtMillis', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == strokeId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.layer == layer
        && request.resource.data.mapId is string
        && request.resource.data.mapId.size() > 0
        && request.resource.data.mapId.size() <= 180
        && request.resource.data.authorUid is string
        && request.resource.data.authorUid.size() > 0
        && request.resource.data.authorUid.size() <= 180
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 160
        && request.resource.data.originalAuthorUid is string
        && request.resource.data.originalAuthorUid.size() <= 180
        && request.resource.data.originalAuthorName is string
        && request.resource.data.originalAuthorName.size() <= 160
        && request.resource.data.restoredByUid is string
        && request.resource.data.restoredByUid.size() <= 180
        && request.resource.data.tool in [
          'pen', 'line', 'rectangle', 'circle', 'arrow'
        ]
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.size is number
        && request.resource.data.size >= 1
        && request.resource.data.size <= 48
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 512
        && request.resource.data.start is map
        && request.resource.data.end is map
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function validFogSettings(roomCode, mapId) {
      return request.resource.data.keys().hasOnly([
          'mapId', 'roomCode', 'enabled', 'baseState', 'revision',
          'updatedByUid', 'updatedAtMillis', 'updatedAt'
        ])
        && request.resource.data.mapId == mapId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.enabled is bool
        && request.resource.data.baseState in ['hidden', 'revealed']
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.revision <= 1000000
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAtMillis is number;
    }

    function validFogOperation(roomCode, operationId) {
      let mapId = request.resource.data.get('mapId', '');
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'mapId', 'revision', 'authorUid', 'mode',
          'tool', 'size', 'points', 'start', 'end', 'order',
          'createdAtMillis', 'createdAt'
        ])
        && request.resource.data.id == operationId
        && request.resource.data.roomCode == roomCode
        && mapId is string
        && mapId.size() > 0
        && mapId.size() <= 180
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.mode in ['reveal', 'hide']
        && request.resource.data.tool in ['brush', 'rectangle', 'circle']
        && request.resource.data.size is number
        && request.resource.data.size >= 4
        && request.resource.data.size <= 400
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 512
        && request.resource.data.start is map
        && request.resource.data.end is map
        && request.resource.data.order is number
        && request.resource.data.createdAtMillis is number
        && exists(fogSettingsPath(roomCode, mapId))
        && get(fogSettingsPath(roomCode, mapId)).data.get('enabled', false) == true
        && request.resource.data.revision
          == get(fogSettingsPath(roomCode, mapId)).data.get('revision', 0);

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function roomExists(roomCode) {
      return exists(roomPath(roomCode));
    }

    function roomData(roomCode) {
      return get(roomPath(roomCode)).data;
    }

    function isRoomDm(roomCode) {
      return signedIn()
        && roomExists(roomCode)
        && roomData(roomCode).dmUid == request.auth.uid;
    }

    function membershipPath(roomCode, uid) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(uid);
    }

    function tokenPath(roomCode, tokenId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/tokens/$(tokenId);
    }

    function ownsRoomToken(roomCode, tokenId) {
      return signedIn()
        && exists(tokenPath(roomCode, tokenId))
        && get(tokenPath(roomCode, tokenId)).data.get('ownerUid', '')
          == request.auth.uid;
    }

    function tokenMovementFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'x',
        'y',
        'movedAtMillis',
        'updatedAtMillis',
        'updatedAt'
      ]);
    }

    function tokenIsCurrentOrExploring(roomCode, tokenId) {
      return roomData(roomCode)
          .get('initiativeState', {})
          .get('combatActive', false) != true
        || roomData(roomCode)
          .get('initiativeState', {})
          .get('currentCombatantId', '') == tokenId;
    }

    function trackedTokenMoveIsConfirmed(roomCode, tokenId) {
      let room = roomData(roomCode);
      let initiative = room.get('initiativeState', {});
      let previous = room.get('movementState', {});
      let movement = getAfter(roomPath(roomCode)).data
        .get('movementState', {});
      let position = movement.get('lastConfirmedPosition', {});
      return initiative.get('combatActive', false) != true
        || (
          initiative.get('currentCombatantId', '') == tokenId
          && movement.get('activeTokenId', '') == tokenId
          && movement.get('movementTurnKey', '')
            == previous.get('movementTurnKey', '')
          && movement.get('movementRemaining', 101)
            < previous.get('movementRemaining', 0)
          && movement.get('movementSpent', -1)
            > previous.get('movementSpent', 100)
          && request.resource.data.x == position.get('x', -1)
          && request.resource.data.y == position.get('y', -1)
        );
    }

    function validPlayerMovementRoomUpdate(roomCode) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let movement = request.resource.data.get('movementState', {});
      let previous = resource.data.get('movementState', {});
      let initiative = resource.data.get('initiativeState', {});
      let tokenId = movement.get('activeTokenId', '');
      let position = movement.get('lastConfirmedPosition', {});
      return isRoomMember(roomCode)
        && changed.hasOnly(['movementState', 'updatedAt'])
        && initiative.get('combatActive', false) == true
        && tokenId == initiative.get('currentCombatantId', '')
        && ownsRoomToken(roomCode, tokenId)
        && movement.get('combatActive', false) == true
        && movement.get('movementTurnKey', '')
          == previous.get('movementTurnKey', '')
        && movement.get('activeTokenId', '')
          == previous.get('activeTokenId', '')
        && movement.get('baseSpeed', -1) >= 0
        && movement.get('baseSpeed', 101) <= 100
        && movement.get('baseSpeed', -1)
          == previous.get('baseSpeed', -2)
        && movement.get('movementRemaining', -1) >= 0
        && movement.get('movementRemaining', 101)
          <= movement.get('baseSpeed', 0)
        && movement.get('movementRemaining', 101)
          < previous.get('movementRemaining', 0)
        && movement.get('movementSpent', -1) >= 0
        && movement.get('movementSpent', -1)
          > previous.get('movementSpent', 100)
        && previous.get('movementRemaining', 0)
          - movement.get('movementRemaining', 0)
          == movement.get('movementSpent', 0)
            - previous.get('movementSpent', 0)
        && movement.get('movementRemaining', 0)
          + movement.get('movementSpent', 0)
          == movement.get('baseSpeed', -1)
        && movement.get('lastMoveForced', true) == false
        && movement.get('movementOverage', -1) == 0
        && getAfter(tokenPath(roomCode, tokenId)).data.x
          == position.get('x', -1)
        && getAfter(tokenPath(roomCode, tokenId)).data.y
          == position.get('y', -1);
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && (
          isRoomDm(roomCode)
          || exists(membershipPath(roomCode, request.auth.uid))
        );
    }

    function ownsCharacter(data) {
      return signedIn()
        && data.get('ownerUid', '') == request.auth.uid;
    }

    function validCharacterWrite(roomCode) {
      return request.resource.data.roomCode == roomCode
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0;
    }

    function validDmOwnedWrite(roomCode) {
      return request.resource.data.roomCode == roomCode
        && request.resource.data.ownerUid == roomData(roomCode).dmUid;
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if isSelf(userId);

      match /rooms/{roomCode} {
        allow read, create, update, delete:
          if isSelf(userId);
      }
    }

    match /rooms/{roomCode} {
      allow create:
        if signedIn()
        && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.roomCode == roomCode;

      allow read:
        if isRoomMember(roomCode);

      allow update:
        if (
          isRoomDm(roomCode)
          && request.resource.data.get('dmUid', resource.data.dmUid)
            == resource.data.dmUid
        )
        || validPlayerMovementRoomUpdate(roomCode);

      allow delete:
        if isRoomDm(roomCode);

      match /players/{playerUid} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if signedIn()
          && request.auth.uid == playerUid
          && roomExists(roomCode)
          && request.resource.data.uid == request.auth.uid
          && (
            request.resource.data.role == 'player'
            || (
              isRoomDm(roomCode)
              && request.resource.data.role == 'dm'
            )
          );

        allow update:
          if isRoomDm(roomCode)
          || (
            isSelf(playerUid)
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == resource.data.role
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            isSelf(playerUid)
            && resource.data.uid == request.auth.uid
          );
      }

      match /activePlayers/{sessionId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if isRoomMember(roomCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sessionId == sessionId;

        allow update:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.sessionId == sessionId
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            signedIn()
            && resource.data.uid == request.auth.uid
          );
      }

      match /characters/{characterId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if isRoomMember(roomCode)
          && validCharacterWrite(roomCode)
          && request.resource.data.ownerUid == request.auth.uid;

        allow update:
          if isRoomMember(roomCode)
          && validCharacterWrite(roomCode)
          && (
            request.resource.data.ownerUid
              == resource.data.get('ownerUid', '')
            || (
              isRoomDm(roomCode)
              && resource.data.get('ownerUid', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
            )
          )
          && (
            ownsCharacter(resource.data)
            || isRoomDm(roomCode)
          );

        allow delete:
          if isRoomMember(roomCode)
          && (
            ownsCharacter(resource.data)
            || isRoomDm(roomCode)
          );
      }

      match /monsters/{monsterId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if isRoomDm(roomCode)
          && validDmOwnedWrite(roomCode);

        allow update:
          if isRoomDm(roomCode)
          && validDmOwnedWrite(roomCode)
          && (
            request.resource.data.ownerUid
              == resource.data.get('ownerUid', '')
            || (
              resource.data.get('ownerUid', '') == ''
              && request.resource.data.ownerUid
                == roomData(roomCode).dmUid
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          && (
            resource.data.get('ownerUid', '') == ''
            || resource.data.ownerUid
              == roomData(roomCode).dmUid
          );
      }

      match /maps/{mapId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update, delete:
          if isRoomDm(roomCode);
      }

      match /puzzleTiles/{tileId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update, delete:
          if isRoomDm(roomCode);
      }

      match /tokens/{tokenId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, delete:
          if isRoomDm(roomCode);
        allow update:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('ownerUid', '')
              == resource.data.get('ownerUid', '')
            && tokenMovementFieldsOnly()
            && tokenIsCurrentOrExploring(roomCode, tokenId)
            && trackedTokenMoveIsConfirmed(roomCode, tokenId)
          );
      }

      match /classes/{classId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update, delete:
          if isRoomDm(roomCode);
      }

      match /species/{speciesId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update, delete:
          if isRoomDm(roomCode);
      }

      match /backgrounds/{backgroundId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update, delete:
          if isRoomDm(roomCode);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

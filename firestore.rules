rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function roomExists(roomCode) {
      return exists(roomPath(roomCode));
    }

    function roomData(roomCode) {
      return get(roomPath(roomCode)).data;
    }

    function isRoomDm(roomCode) {
      return signedIn()
        && roomExists(roomCode)
        && roomData(roomCode).dmUid == request.auth.uid;
    }

    function membershipPath(roomCode, uid) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(uid);
    }

    function tokenPath(roomCode, tokenId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/tokens/$(tokenId);
    }

    function characterPath(roomCode, characterId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/characters/$(characterId);
    }

    function ownsRoomToken(roomCode, tokenId) {
      return signedIn()
        && exists(tokenPath(roomCode, tokenId))
        && get(tokenPath(roomCode, tokenId)).data.get('ownerUid', '')
          == request.auth.uid;
    }

    function tokenMovementFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'x',
        'y',
        'movedAtMillis',
        'updatedAtMillis',
        'updatedAt'
      ]);
    }

    function linkedCharacterSyncFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'imageUrl',
        'publicId',
        'sizeCategory',
        'creatureSize',
        'size',
        'armorClass',
        'ac',
        'dexterity',
        'initiativeBonus',
        'movementSpeed',
        'baseSpeed',
        'ownerUid',
        'currentHp',
        'maxHp',
        'hp',
        'hpAuthority',
        'linkedCharacterId',
        'sheetId',
        'sourceType',
        'linkedCharacterRevision',
        'linkedCharacter',
        'updatedAtMillis',
        'updatedAt'
      ]);
    }

    function validLinkedCharacterTokenSync(roomCode) {
      let characterId = resource.data.get('linkedCharacterId', '');
      let character = get(characterPath(roomCode, characterId)).data;
      let combat = character.get('combat', {});
      let identity = character.get('identity', {});
      let baseSpeed = combat.get('baseSpeed', {});
      return characterId != ''
        && exists(characterPath(roomCode, characterId))
        && linkedCharacterSyncFieldsOnly()
        && resource.data.get('sourceType', '') == 'character'
        && request.resource.data.get('sourceType', '') == 'character'
        && request.resource.data.get('linkedCharacterId', '') == characterId
        && request.resource.data.get('sheetId', '') == characterId
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && character.get('ownerUid', '') == request.auth.uid
        && character.get('roomCode', '') == roomCode
        && request.resource.data.get('linkedCharacterRevision', 0)
          == character.get('revision', -1)
        && request.resource.data.get('linkedCharacterRevision', 0)
          > resource.data.get('linkedCharacterRevision', 0)
        && request.resource.data.get('hpAuthority', '') == 'character'
        && request.resource.data.get('name', '') == identity.get('name', '')
        && request.resource.data.get('currentHp', -1)
          == combat.get('currentHp', -2)
        && request.resource.data.get('maxHp', -1)
          == combat.get('maxHp', -2)
        && request.resource.data.get('armorClass', -1)
          == combat.get('armorClass', -2)
        && request.resource.data.get('ac', -1)
          == combat.get('armorClass', -2)
        && request.resource.data.get('movementSpeed', -1)
          == baseSpeed.get('walk', -2)
        && request.resource.data.get('baseSpeed', -1)
          == baseSpeed.get('walk', -2)
        && request.resource.data.get('linkedCharacter', {}).get('id', '')
          == characterId
        && request.resource.data.get('linkedCharacter', {}).get('ownerUid', '')
          == request.auth.uid;
    }

    function tokenIsCurrentOrExploring(roomCode, tokenId) {
      return roomData(roomCode)
          .get('initiativeState', {})
          .get('combatActive', false) != true
        || roomData(roomCode)
          .get('initiativeState', {})
          .get('currentCombatantId', '') == tokenId;
    }

    function trackedTokenMoveIsConfirmed(roomCode, tokenId) {
      let room = roomData(roomCode);
      let initiative = room.get('initiativeState', {});
      let previous = room.get('movementState', {});
      let movement = getAfter(roomPath(roomCode)).data
        .get('movementState', {});
      let position = movement.get('lastConfirmedPosition', {});
      return initiative.get('combatActive', false) != true
        || (
          initiative.get('currentCombatantId', '') == tokenId
          && movement.get('activeTokenId', '') == tokenId
          && movement.get('movementTurnKey', '')
            == previous.get('movementTurnKey', '')
          && movement.get('movementRemaining', 101)
            < previous.get('movementRemaining', 0)
          && movement.get('movementSpent', -1)
            > previous.get('movementSpent', 100)
          && request.resource.data.x == position.get('x', -1)
          && request.resource.data.y == position.get('y', -1)
        );
    }

    function validPlayerMovementRoomUpdate(roomCode) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let movement = request.resource.data.get('movementState', {});
      let previous = resource.data.get('movementState', {});
      let initiative = resource.data.get('initiativeState', {});
      let tokenId = movement.get('activeTokenId', '');
      let position = movement.get('lastConfirmedPosition', {});
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && changed.hasOnly(['movementState', 'updatedAt'])
        && initiative.get('combatActive', false) == true
        && tokenId == initiative.get('currentCombatantId', '')
        && ownsRoomToken(roomCode, tokenId)
        && movement.get('combatActive', false) == true
        && movement.get('movementTurnKey', '')
          == previous.get('movementTurnKey', '')
        && movement.get('activeTokenId', '')
          == previous.get('activeTokenId', '')
        && movement.get('baseSpeed', -1) >= 0
        && movement.get('baseSpeed', 101) <= 100
        && movement.get('baseSpeed', -1)
          == previous.get('baseSpeed', -2)
        && movement.get('movementRemaining', -1) >= 0
        && movement.get('movementRemaining', 101)
          <= movement.get('baseSpeed', 0)
        && movement.get('movementRemaining', 101)
          < previous.get('movementRemaining', 0)
        && movement.get('movementSpent', -1) >= 0
        && movement.get('movementSpent', -1)
          > previous.get('movementSpent', 100)
        && previous.get('movementRemaining', 0)
          - movement.get('movementRemaining', 0)
          == movement.get('movementSpent', 0)
            - previous.get('movementSpent', 0)
        && movement.get('movementRemaining', 0)
          + movement.get('movementSpent', 0)
          == movement.get('baseSpeed', -1)
        && movement.get('lastMoveForced', true) == false
        && movement.get('movementOverage', -1) == 0
        && getAfter(tokenPath(roomCode, tokenId)).data.x
          == position.get('x', -1)
        && getAfter(tokenPath(roomCode, tokenId)).data.y
          == position.get('y', -1);
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && (
          isRoomDm(roomCode)
          || exists(membershipPath(roomCode, request.auth.uid))
        );
    }

    function roomAcceptsWrites(roomCode) {
      return roomExists(roomCode)
        && roomData(roomCode).get('deletingAt', null) == null;
    }

    function deletionLifecycleFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deletionState', 'deletionUpdatedAt'
      ])
        && request.resource.data.get('deletingAt', null)
          == resource.data.get('deletingAt', null);
    }

    function ownsCharacter(data) {
      return signedIn()
        && data.get('ownerUid', '') == request.auth.uid;
    }

    function validPersonalLibraryRevision(userId) {
      let nextRevision = request.resource.data.get('revision', 0);
      return nextRevision is int
        && nextRevision >= 1
        && (
          (
            resource == null
            && nextRevision == 1
          )
          || (
            resource != null
            && resource.data.get('ownerUid', '') == userId
            && nextRevision == resource.data.get('revision', 0) + 1
          )
        );
    }

    function validCharacterWrite(roomCode) {
      return request.resource.data.roomCode == roomCode
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }

    function validDmOwnedWrite(roomCode) {
      return request.resource.data.roomCode == roomCode
        && request.resource.data.ownerUid == roomData(roomCode).dmUid;
    }

    function validGameplayEffect(roomCode, effectId) {
      return request.resource.data.keys().hasOnly([
          'id', 'definitionId', 'name', 'type', 'icon', 'description',
          'roomCode', 'sourceId', 'sourceType', 'targetTokenId',
          'targetCharacterId', 'duration', 'timing', 'modifiers', 'tags',
          'animation', 'createdByUid', 'createdAtMillis', 'updatedAtMillis',
          'updatedAt'
        ])
        && request.resource.data.id == effectId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.definitionId is string
        && request.resource.data.definitionId.size() > 0
        && request.resource.data.definitionId.size() <= 180
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.type in [
          'condition', 'buff', 'debuff', 'other'
        ]
        && request.resource.data.targetTokenId is string
        && request.resource.data.targetTokenId.size() > 0
        && request.resource.data.targetTokenId.size() <= 180
        && request.resource.data.duration is map
        && request.resource.data.timing is map
        && request.resource.data.modifiers is list
        && request.resource.data.modifiers.size() <= 24
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20
        && request.resource.data.animation is map
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function validJournalEntry(roomCode, entryId, visibility) {
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'ownerUid', 'ownerName', 'title', 'category',
          'visibility', 'contentHtml', 'searchText', 'createdAtMillis',
          'updatedAtMillis', 'revision', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == entryId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.visibility == visibility
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.ownerUid.size() <= 180
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 160
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && request.resource.data.contentHtml is string
        && request.resource.data.contentHtml.size() <= 50000
        && request.resource.data.searchText is string
        && request.resource.data.searchText.size() <= 50000
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function validDrawingStroke(roomCode, strokeId, layer) {
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'mapId', 'authorUid', 'authorName', 'layer',
          'tool', 'color', 'size', 'points', 'start', 'end',
          'originalAuthorUid', 'originalAuthorName', 'restoredByUid',
          'createdAtMillis', 'updatedAtMillis', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == strokeId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.layer == layer
        && request.resource.data.mapId is string
        && request.resource.data.mapId.size() > 0
        && request.resource.data.mapId.size() <= 180
        && request.resource.data.authorUid is string
        && request.resource.data.authorUid.size() > 0
        && request.resource.data.authorUid.size() <= 180
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 160
        && request.resource.data.originalAuthorUid is string
        && request.resource.data.originalAuthorUid.size() <= 180
        && request.resource.data.originalAuthorName is string
        && request.resource.data.originalAuthorName.size() <= 160
        && request.resource.data.restoredByUid is string
        && request.resource.data.restoredByUid.size() <= 180
        && request.resource.data.tool in [
          'pen', 'line', 'rectangle', 'circle', 'arrow'
        ]
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.size is number
        && request.resource.data.size >= 1
        && request.resource.data.size <= 48
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 512
        && request.resource.data.start is map
        && request.resource.data.end is map
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function playerDrawingEnabled(roomCode) {
      return roomData(roomCode)
        .get('drawingSettings', {})
        .get('playersEnabled', false) == true;
    }

    function validWorkshopAssetType(value) {
      return value in [
        'monster', 'magic-item', 'spell', 'animation', 'npc',
        'map', 'encounter', 'summon', 'feat', 'other'
      ];
    }

    function validWorkshopVisibility(value) {
      return value in ['PRIVATE', 'ROOM', 'FRIENDS', 'PUBLIC'];
    }

    function canReadWorkshopAsset(data) {
      return signedIn()
        && (
          data.authorUid == request.auth.uid
          || data.visibility == 'PUBLIC'
          || (
            data.visibility == 'ROOM'
            && data.roomCode is string
            && isRoomMember(data.roomCode)
          )
        );
    }

    function validWorkshopSummary(assetId) {
      return request.resource.data.keys().hasOnly([
          'assetId', 'assetType', 'name', 'nameSearch', 'description',
          'authorUid', 'authorName', 'visibility', 'roomCode', 'tags',
          'thumbnailUrl', 'version', 'forkedFrom', 'sourceKey',
          'sourceType', 'sourceRecordId', 'typeMetadata',
          'collectionIds', 'saveCount', 'createdAt',
          'updatedAt', 'createdAtMillis', 'updatedAtMillis'
        ])
        && request.resource.data.assetId == assetId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && validWorkshopAssetType(request.resource.data.assetType)
        && request.resource.data.sourceType is string
        && request.resource.data.sourceType.size() <= 80
        && request.resource.data.typeMetadata is map
        && validWorkshopVisibility(request.resource.data.visibility)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 16
        && request.resource.data.thumbnailUrl is string
        && (
          request.resource.data.thumbnailUrl == ''
          || request.resource.data.thumbnailUrl.matches('https://.*')
        )
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 1000000
        && (
          request.resource.data.visibility != 'ROOM'
          || (
            request.resource.data.roomCode is string
            && isRoomMember(request.resource.data.roomCode)
          )
        );
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if isSelf(userId);

      match /rooms/{roomCode} {
        allow read, create, update, delete:
          if isSelf(userId);
      }

      match /animations/{animationId} {
        allow read, delete:
          if isSelf(userId);

        allow create, update:
          if isSelf(userId)
          && request.resource.data.get('id', '') == animationId
          && request.resource.data.get('ownerId', '') == userId
          && request.resource.data.get('ownership', {}).get('scope', '') == 'user'
          && request.resource.data.get('ownership', {}).get('ownerId', '') == userId
          && request.resource.data.get('sprite', '') is string
          && request.resource.data.get('sprite', '').matches('https://.*')
          && (
            request.resource.data.get('sound', null) == null
            || request.resource.data.get('sound', {}).get('src', '') == ''
            || request.resource.data.get('sound', {}).get('src', '').matches('https://.*')
          );
      }

      match /magicItems/{itemId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == itemId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.itemType in [
            'weapon', 'armor', 'consumable', 'wondrous-item'
          ]
          && request.resource.data.rarity in [
            'common', 'uncommon', 'rare', 'very-rare',
            'legendary', 'artifact', 'varies'
          ]
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 8000
          && request.resource.data.imageUrl is string
          && (
            request.resource.data.imageUrl == ''
            || request.resource.data.imageUrl.matches('https://.*')
          )
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 16
          && request.resource.data.effects is list
          && request.resource.data.effects.size() <= 30
          && request.resource.data.updatedAtMillis is number;
      }

      match /spells/{spellId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == spellId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.level is int
          && request.resource.data.level >= 0
          && request.resource.data.level <= 9
          && request.resource.data.school is string
          && request.resource.data.school.size() > 0
          && request.resource.data.school.size() <= 40
          && request.resource.data.classes is list
          && request.resource.data.classes.size() <= 20
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 12000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.animations is map
          && request.resource.data.updatedAtMillis is number;
      }

      match /npcs/{npcId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == npcId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.portraitUrl is string
          && (
            request.resource.data.portraitUrl == ''
            || request.resource.data.portraitUrl.matches('https://.*')
          )
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.size() <= 40
          && (
            request.resource.data.roomCode == ''
            || isRoomMember(request.resource.data.roomCode)
          )
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 8000
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 12000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 24
          && request.resource.data.relationshipIds is list
          && request.resource.data.relationshipIds.size() <= 100
          && request.resource.data.factionIds is list
          && request.resource.data.factionIds.size() <= 50
          && request.resource.data.knowledge is list
          && request.resource.data.knowledge.size() <= 100
          && request.resource.data.combat is map
          && request.resource.data.updatedAtMillis is number;
      }
      match /npcRelationships/{relationshipId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == relationshipId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.sourceNpcId is string
          && request.resource.data.sourceNpcId.size() > 0
          && request.resource.data.sourceNpcId.size() <= 160
          && request.resource.data.targetNpcId is string
          && request.resource.data.targetNpcId.size() > 0
          && request.resource.data.targetNpcId.size() <= 160
          && request.resource.data.sourceNpcId != request.resource.data.targetNpcId
          && request.resource.data.relationshipType in [
            'Friend', 'Ally', 'Enemy', 'Rival', 'Family', 'Lover',
            'Employer', 'Employee', 'Leader', 'Follower', 'Contact',
            'Knows', 'Distrusts', 'Owes', 'Custom'
          ]
          && request.resource.data.direction in ['directed', 'mutual']
          && request.resource.data.trust is number
          && request.resource.data.trust >= 0
          && request.resource.data.trust <= 100
          && request.resource.data.hostility is number
          && request.resource.data.hostility >= 0
          && request.resource.data.hostility <= 100
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 5000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.createdAtMillis is number
          && request.resource.data.updatedAtMillis is number;
      }


      match /encounters/{encounterId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == encounterId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 12000
          && request.resource.data.environment is string
          && request.resource.data.environment.size() <= 2000
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.size() <= 40
          && (
            request.resource.data.roomCode == ''
            || isRoomMember(request.resource.data.roomCode)
          )
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 24
          && (
            request.resource.data.mapRef == null
            || request.resource.data.mapRef is map
          )
          && request.resource.data.combatants is list
          && request.resource.data.combatants.size() <= 50
          && request.resource.data.lighting is map
          && request.resource.data.updatedAtMillis is number;
      }

      match /summons/{summonId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == summonId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.sourceLibraryId is string
          && request.resource.data.sourceLibraryId.size() <= 241
          && request.resource.data.source is map
          && request.resource.data.source.get('assetType', '') in [
            'monster', 'npc', 'character', 'custom'
          ]
          && request.resource.data.source.get('libraryId', '') is string
          && request.resource.data.source.get('sourceRecordId', '') is string
          && request.resource.data.count is int
          && request.resource.data.count >= 1
          && request.resource.data.count <= 20
          && request.resource.data.placement is map
          && request.resource.data.ownership is map
          && request.resource.data.initiative is map
          && request.resource.data.duration is map
          && request.resource.data.endBehavior is map
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.updatedAtMillis is number;
      }

      match /libraryIndex/{libraryId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.libraryId == libraryId
          && (
            request.resource.data.assetType == 'monster'
            || request.resource.data.assetType == 'map'
          )
          && request.resource.data.sourceRecordId is string
          && request.resource.data.sourceRecordId.size() > 0
          && request.resource.data.sourceRoomCode is string
          && request.resource.data.sourceRoomCode.size() > 0
          && request.resource.data.ownerUid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.updatedAtMillis is number;
      }

      match /workshopFavorites/{assetId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.assetId == assetId;
      }

      match /workshopImports/{assetId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /workshopCollections/{collectionId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.collectionId == collectionId
          && request.resource.data.ownerUid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.assetIds is list
          && request.resource.data.assetIds.size() <= 500
          && request.resource.data.get('entries', []) is list
          && request.resource.data.get('entries', []).size() <= 500;
      }

      match /workshopLibrary/{recordId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /workshopAssets/{assetId} {
      allow read: if canReadWorkshopAsset(resource.data);

      allow create:
        if signedIn()
        && validWorkshopSummary(assetId);

      allow update:
        if signedIn()
        && (
          (
            resource.data.authorUid == request.auth.uid
            && validWorkshopSummary(assetId)
            && request.resource.data.version >= resource.data.version
            && request.resource.data.version <= resource.data.version + 1
          )
          || (
            resource.data.visibility == 'ROOM'
            && isRoomDm(resource.data.roomCode)
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.visibility == 'PRIVATE'
            && request.resource.data.roomCode == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'visibility', 'roomCode', 'updatedAt', 'updatedAtMillis'
            ])
          )
        );

      allow delete:
        if signedIn()
        && resource.data.authorUid == request.auth.uid;

      match /versions/{versionId} {
        allow read:
          if exists(/databases/$(database)/documents/workshopAssets/$(assetId))
          && canReadWorkshopAsset(
            get(/databases/$(database)/documents/workshopAssets/$(assetId)).data
          );

        allow create:
          if signedIn()
          && existsAfter(/databases/$(database)/documents/workshopAssets/$(assetId))
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.authorUid
            == request.auth.uid
          && request.resource.data.assetId == assetId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && versionId == string(request.resource.data.version)
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.version
            == request.resource.data.version
          && request.resource.data.content is map
          && request.resource.data.keys().hasOnly([
            'assetId', 'version', 'authorUid', 'createdAt',
            'createdAtMillis', 'content'
          ]);

        allow update:
          if signedIn()
          && existsAfter(/databases/$(database)/documents/workshopAssets/$(assetId))
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.authorUid
            == request.auth.uid
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.version
            == resource.data.version
          && request.resource.data.assetId == resource.data.assetId
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.version == resource.data.version
          && versionId == string(resource.data.version)
          && request.resource.data.content is map
          && request.resource.data.keys().hasOnly([
            'assetId', 'version', 'authorUid', 'createdAt',
            'createdAtMillis', 'content'
          ]);

        allow delete:
          if signedIn()
          && exists(/databases/$(database)/documents/workshopAssets/$(assetId))
          && get(/databases/$(database)/documents/workshopAssets/$(assetId)).data.authorUid
            == request.auth.uid;
      }
    }

    match /rooms/{roomCode} {
      allow create:
        if signedIn()
        && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.roomCode == roomCode;

      allow read:
        if isRoomMember(roomCode);

      allow update:
        if (
          isRoomDm(roomCode)
          && request.resource.data.get('dmUid', resource.data.dmUid)
            == resource.data.dmUid
          && (
            roomAcceptsWrites(roomCode)
            || deletionLifecycleFieldsOnly()
          )
        )
        || validPlayerMovementRoomUpdate(roomCode);

      allow delete:
        if isRoomDm(roomCode);

      match /players/{playerUid} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if signedIn()
          && request.auth.uid == playerUid
          && roomExists(roomCode)
          && roomAcceptsWrites(roomCode)
          && request.resource.data.uid == request.auth.uid
          && (
            request.resource.data.role == 'player'
            || (
              isRoomDm(roomCode)
              && request.resource.data.role == 'dm'
            )
          );

        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isSelf(playerUid)
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.role == resource.data.role
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            isSelf(playerUid)
            && resource.data.uid == request.auth.uid
          );
      }

      match /activePlayers/{sessionId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sessionId == sessionId;

        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isRoomMember(roomCode)
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.sessionId == sessionId
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            signedIn()
            && resource.data.uid == request.auth.uid
          );
      }

      match /characters/{characterId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validCharacterWrite(roomCode)
          && request.resource.data.ownerUid == request.auth.uid;

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validCharacterWrite(roomCode)
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && (
            request.resource.data.ownerUid
              == resource.data.get('ownerUid', '')
            || (
              isRoomDm(roomCode)
              && resource.data.get('ownerUid', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
            )
          )
          && (
            ownsCharacter(resource.data)
            || isRoomDm(roomCode)
          );

        allow delete:
          if isRoomMember(roomCode)
          && (
            ownsCharacter(resource.data)
            || isRoomDm(roomCode)
          );
      }

      match /monsters/{monsterId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validDmOwnedWrite(roomCode)
          && request.resource.data.get('revision', 0) == 1;

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validDmOwnedWrite(roomCode)
          && request.resource.data.get('revision', 0)
            == resource.data.get('revision', 0) + 1
          && (
            request.resource.data.ownerUid
              == resource.data.get('ownerUid', '')
            || (
              resource.data.get('ownerUid', '') == ''
              && request.resource.data.ownerUid
                == roomData(roomCode).dmUid
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          && (
            resource.data.get('ownerUid', '') == ''
            || resource.data.ownerUid
              == roomData(roomCode).dmUid
          );
      }

      match /animations/{animationId} {
        allow read:
          if isRoomMember(roomCode);

        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.get('id', '') == animationId
          && request.resource.data.get('roomCode', '') == roomCode
          && request.resource.data.get('ownerId', '') == roomCode
          && request.resource.data.get('ownership', {}).get('scope', '') == 'room'
          && request.resource.data.get('ownership', {}).get('ownerId', '') == roomCode
          && request.resource.data.get('sprite', '') is string
          && request.resource.data.get('sprite', '').matches('https://.*')
          && (
            request.resource.data.get('sound', null) == null
            || request.resource.data.get('sound', {}).get('src', '') == ''
            || request.resource.data.get('sound', {}).get('src', '').matches('https://.*')
          );

        allow delete:
          if isRoomDm(roomCode);
      }

      match /combatEffects/{effectId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && request.resource.data.get('id', '') == effectId
          && request.resource.data.get('roomCode', '') == roomCode
          && request.resource.data.get('createdByUid', '') == request.auth.uid;

        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isRoomMember(roomCode)
              && resource.data.get('createdByUid', '') == request.auth.uid
            )
          )
          && request.resource.data.get('id', '') == effectId
          && request.resource.data.get('roomCode', '') == roomCode
          && request.resource.data.get('createdByUid', '')
            == resource.data.get('createdByUid', '');

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.get('createdByUid', '') == request.auth.uid
          );
      }

      match /effects/{effectId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validGameplayEffect(roomCode, effectId);

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validGameplayEffect(roomCode, effectId)
          && request.resource.data.createdByUid
            == resource.data.createdByUid
          && request.resource.data.createdAtMillis
            == resource.data.createdAtMillis;

        allow delete:
          if isRoomDm(roomCode);
      }

      match /sharedJournal/{entryId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validJournalEntry(roomCode, entryId, 'shared')
          && (
            isRoomDm(roomCode)
            || request.resource.data.ownerUid == request.auth.uid
          );

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validJournalEntry(roomCode, entryId, 'shared')
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && (
            isRoomDm(roomCode)
            || resource.data.ownerUid == request.auth.uid
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.ownerUid == request.auth.uid
          );
      }

      match /personalJournal/{entryId} {
        allow read:
          if isRoomMember(roomCode)
          && resource.data.ownerUid == request.auth.uid;

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validJournalEntry(roomCode, entryId, 'personal')
          && request.resource.data.ownerUid == request.auth.uid;

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && validJournalEntry(roomCode, entryId, 'personal');

        allow delete:
          if isRoomMember(roomCode)
          && resource.data.ownerUid == request.auth.uid;
      }

      match /dmJournal/{entryId} {
        allow read:
          if isRoomDm(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validJournalEntry(roomCode, entryId, 'dm');

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && validJournalEntry(roomCode, entryId, 'dm');

        allow delete:
          if isRoomDm(roomCode);
      }

      match /sharedDrawings/{strokeId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && request.resource.data.authorUid == request.auth.uid
          && validDrawingStroke(roomCode, strokeId, 'shared')
          && (
            isRoomDm(roomCode)
            || playerDrawingEnabled(roomCode)
          );

        allow update:
          if false;

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.authorUid == request.auth.uid
            && playerDrawingEnabled(roomCode)
          );
      }

      match /dmDrawings/{strokeId} {
        allow read:
          if isRoomDm(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.authorUid == request.auth.uid
          && validDrawingStroke(roomCode, strokeId, 'dm');

        allow update:
          if false;

        allow delete:
          if isRoomDm(roomCode);
      }

      match /maps/{mapId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /puzzleTiles/{tileId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /tokens/{tokenId} {
        allow read:
          if isRoomMember(roomCode);
        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isRoomMember(roomCode)
              && resource.data.get('ownerUid', '') == request.auth.uid
              && request.resource.data.get('ownerUid', '')
                == resource.data.get('ownerUid', '')
              && (
                (
                  tokenMovementFieldsOnly()
                  && tokenIsCurrentOrExploring(roomCode, tokenId)
                  && trackedTokenMoveIsConfirmed(roomCode, tokenId)
                )
                || validLinkedCharacterTokenSync(roomCode)
              )
            )
          );
      }

      match /classes/{classId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /species/{speciesId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /backgrounds/{backgroundId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

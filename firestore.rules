    function validVisionPoint(point) {
      return point is map
        && point.keys().hasOnly(['x', 'y'])
        && point.x is number
        && point.x >= 0
        && point.x <= 1000
        && point.y is number
        && point.y >= 0
        && point.y <= 1000;
    }

    function validVisionWall(roomCode, wallId) {
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'mapId', 'authorUid', 'start', 'end',
          'createdAtMillis', 'updatedAtMillis', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == wallId
        && request.resource.data.roomCode == roomCode
        && request.resource.data.mapId is string
        && request.resource.data.mapId.size() > 0
        && request.resource.data.mapId.size() <= 180
        && request.resource.data.authorUid == request.auth.uid
        && validVisionPoint(request.resource.data.start)
        && validVisionPoint(request.resource.data.end)
        && request.resource.data.createdAtMillis is number
        && request.resource.data.updatedAtMillis is number;
    }

    function validVisionExploration(roomCode) {
      let resolution = request.resource.data.get('resolution', 0);
      let cells = request.resource.data.get('cells', '');
      return request.resource.data.keys().hasOnly([
          'roomCode', 'mapId', 'ownerUid', 'resolution', 'cells',
          'updatedAtMillis', 'updatedAt'
        ])
        && request.resource.data.roomCode == roomCode
        && request.resource.data.mapId is string
        && request.resource.data.mapId.size() > 0
        && request.resource.data.mapId.size() <= 180
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.ownerUid.size() <= 180
        && resolution is int
        && resolution >= 16
        && resolution <= 128
        && cells is string
        && cells.size() == resolution * resolution
        && cells.matches('^[01]+$')
        && request.resource.data.updatedAtMillis is number;
    }

    function validScene(roomCode, sceneId) {
      return request.resource.data.get('id', '') == sceneId
        && request.resource.data.get('roomCode', '') == roomCode
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 4000
        && request.resource.data.get('createdAtMillis', -1) is number
        && request.resource.data.get('updatedAtMillis', -1) is number;
    }

    function validFloor(roomCode, sceneId, floorId) {
      let map = request.resource.data.get('map', {});
      return request.resource.data.get('id', '') == floorId
        && !request.resource.data.keys().hasAny(['dmNotes', 'privateNotes'])
        && request.resource.data.get('sceneId', '') == sceneId
        && request.resource.data.get('roomCode', '') == roomCode
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('baseElevation', 1001) >= -1000
        && request.resource.data.get('baseElevation', -1001) <= 1000
        && request.resource.data.get('order', 0) is int
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 4000
        && map is map
        && (
          map.get('url', '') == ''
          || map.get('url', '').matches('https://.*')
        );
    }

    function validFloorConnection(roomCode, sceneId, connectionId) {
      let source = request.resource.data.get('source', {});
      let destination = request.resource.data.get('destination', {});
      return request.resource.data.get('id', '') == connectionId
        && request.resource.data.get('sceneId', '') == sceneId
        && request.resource.data.get('roomCode', '') == roomCode
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('type', '') in [
          'stairs', 'ladder', 'trapdoor', 'elevator', 'portal', 'custom'
        ]
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 1000
        && source is map
        && destination is map
        && source.get('floorId', '') != ''
        && destination.get('floorId', '') != ''
        && source.get('floorId', '') != destination.get('floorId', '')
        && exists(floorPath(roomCode, sceneId, source.get('floorId', '')))
        && exists(floorPath(roomCode, sceneId, destination.get('floorId', '')))
        && source.get('x', -1) >= 0
        && source.get('x', 101) <= 100
        && source.get('y', -1) >= 0
        && source.get('y', 101) <= 100
        && destination.get('x', -1) >= 0
        && destination.get('x', 101) <= 100
        && destination.get('y', -1) >= 0
        && destination.get('y', 101) <= 100
        && request.resource.data.get('bidirectional', null) is bool
        && request.resource.data.get('allowPlayers', null) is bool
        && request.resource.data.get('movementCost', -1) >= 0
        && request.resource.data.get('movementCost', 1001) <= 1000;
    }

    function validMapObjectState(type, stateId) {
      return (
          type == 'door' && stateId in ['closed', 'open']
        ) || (
          type == 'chest' && stateId in ['closed', 'open', 'looted']
        ) || (
          type in ['lever', 'button', 'pressure-plate', 'custom']
          && stateId in ['inactive', 'active']
        ) || (
          type == 'trap' && stateId in ['armed', 'activated', 'disabled']
        ) || (
          type == 'destructible' && stateId in ['intact', 'damaged', 'destroyed']
        ) || (
          type == 'furniture' && stateId in ['intact', 'moved', 'destroyed']
        );
    }

    function validMapObject(roomCode, objectId, visibility) {
      let transform = request.resource.data.get('transform', {});
      let hitPoints = request.resource.data.get('hitPoints', {});
      let interactionRadius = request.resource.data.get('interactionRadius', {});
      let type = request.resource.data.get('type', '');
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'kind', 'type', 'name', 'description',
          'imageUrl', 'imagePublicId', 'icon', 'sceneId', 'floorId',
          'mapId', 'transform', 'stateId', 'locked', 'allowPlayers',
          'visibility', 'interactionDistanceFeet', 'interactionRadius', 'blocksMovement',
          'blocksVision', 'hitPoints', 'animationId', 'revision',
          'createdByUid', 'updatedByUid', 'lastInteractedByUid',
          'lastInteractorTokenId', 'lastPuzzleExecutionId',
          'createdAtMillis', 'updatedAtMillis',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('id', '') == objectId
        && request.resource.data.get('roomCode', '') == roomCode
        && request.resource.data.get('kind', '') == 'object'
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('visibility', '') == visibility
        && type in [
          'door', 'chest', 'lever', 'button', 'pressure-plate',
          'trap', 'destructible', 'furniture', 'custom'
        ]
        && validMapObjectState(type, request.resource.data.get('stateId', ''))
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('imageUrl', '').size() <= 2000
        && (
          request.resource.data.get('imageUrl', '') == ''
          || request.resource.data.get('imageUrl', '').matches('https://.*')
        )
        && request.resource.data.get('imagePublicId', '') is string
        && request.resource.data.get('imagePublicId', '').size() <= 500
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('icon', '').size() <= 16
        && request.resource.data.get('sceneId', '') is string
        && request.resource.data.get('floorId', '') is string
        && request.resource.data.get('mapId', '') is string
        && request.resource.data.get('mapId', '').size() > 0
        && request.resource.data.get('mapId', '').size() <= 300
        && (
          (
            request.resource.data.get('sceneId', '') == ''
            && request.resource.data.get('floorId', '') == ''
          )
          || (
            request.resource.data.get('sceneId', '') != ''
            && request.resource.data.get('floorId', '') != ''
            && exists(floorPath(
              roomCode,
              request.resource.data.get('sceneId', ''),
              request.resource.data.get('floorId', '')
            ))
          )
        )
        && transform is map
        && transform.keys().hasOnly(['x', 'y', 'width', 'height', 'rotation'])
        && transform.get('x', -1) >= 0
        && transform.get('x', 101) <= 100
        && transform.get('y', -1) >= 0
        && transform.get('y', 101) <= 100
        && transform.get('width', 0) >= 1
        && transform.get('width', 101) <= 100
        && transform.get('height', 0) >= 1
        && transform.get('height', 101) <= 100
        && transform.get('rotation', -361) >= -360
        && transform.get('rotation', 361) <= 360
        && request.resource.data.get('locked', null) is bool
        && request.resource.data.get('allowPlayers', null) is bool
        && request.resource.data.get('blocksMovement', null) is bool
        && request.resource.data.get('blocksVision', null) is bool
        && request.resource.data.get('interactionDistanceFeet', 4) >= 5
        && request.resource.data.get('interactionDistanceFeet', 121) <= 120
        && interactionRadius is map
        && interactionRadius.keys().hasOnly(['x', 'y'])
        && interactionRadius.get('x', 0) >= 0.1
        && interactionRadius.get('x', 101) <= 100
        && interactionRadius.get('y', 0) >= 0.1
        && interactionRadius.get('y', 101) <= 100
        && hitPoints is map
        && hitPoints.keys().hasOnly(['current', 'maximum'])
        && hitPoints.get('current', -1) >= 0
        && hitPoints.get('maximum', -1) >= 0
        && hitPoints.get('current', 100001) <= 100000
        && hitPoints.get('maximum', 100001) <= 100000
        && request.resource.data.get('animationId', '') is string
        && request.resource.data.get('animationId', '').size() <= 180
        && request.resource.data.get('revision', 0) is int
        && request.resource.data.get('revision', 0) >= 1
        && request.resource.data.get('createdByUid', '') is string
        && request.resource.data.get('updatedByUid', '') is string
        && request.resource.data.get('lastInteractedByUid', '') is string
        && request.resource.data.get('lastInteractorTokenId', '') is string
        && request.resource.data.get('lastPuzzleExecutionId', '') is string
        && request.resource.data.get('lastPuzzleExecutionId', '').size() <= 180
        && request.resource.data.get('createdAtMillis', -1) is number
        && request.resource.data.get('updatedAtMillis', -1) is number;
    }

    function validPlayerObjectTransition(type, before, after) {
      return (
          type == 'door'
          && ((before == 'closed' && after == 'open') || (before == 'open' && after == 'closed'))
        ) || (
          type == 'chest'
          && ((before == 'closed' && after == 'open') || (before == 'open' && after == 'looted') || (before == 'looted' && after == 'closed'))
        ) || (
          type in ['lever', 'button', 'pressure-plate', 'custom']
          && ((before == 'inactive' && after == 'active') || (before == 'active' && after == 'inactive'))
        ) || (
          type == 'trap'
          && ((before == 'armed' && after == 'activated') || (before == 'activated' && after == 'disabled') || (before == 'disabled' && after == 'armed'))
        );
    }

    function validPlayerMapObjectInteraction(roomCode) {
      let tokenId = request.resource.data.get('lastInteractorTokenId', '');
      let token = get(tokenPath(roomCode, tokenId)).data;
      let transform = resource.data.get('transform', {});
      let interactionRadius = resource.data.get('interactionRadius', {});
      let type = resource.data.get('type', '');
      return roomAcceptsWrites(roomCode)
        && isRoomMember(roomCode)
        && resource.data.get('visibility', '') == 'shared'
        && resource.data.get('allowPlayers', false) == true
        && resource.data.get('locked', true) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stateId', 'blocksMovement', 'blocksVision', 'revision',
          'lastInteractedByUid', 'lastInteractorTokenId', 'updatedByUid',
          'lastPuzzleExecutionId', 'updatedAtMillis', 'updatedAt'
        ])
        && request.resource.data.get('revision', 0) == resource.data.get('revision', 0) + 1
        && request.resource.data.get('lastInteractedByUid', '') == request.auth.uid
        && request.resource.data.get('updatedByUid', '') == request.auth.uid
        && request.resource.data.get('lastPuzzleExecutionId', '') == ''
        && tokenId != ''
        && exists(tokenPath(roomCode, tokenId))
        && token.get('ownerUid', '') == request.auth.uid
        && token.get('sceneId', '') == resource.data.get('sceneId', '')
        && token.get('floorId', '') == resource.data.get('floorId', '')
        && token.get('x', -101) >= transform.get('x', 0) - interactionRadius.get('x', 0)
        && token.get('x', 101) <= transform.get('x', 0) + interactionRadius.get('x', 0)
        && token.get('y', -101) >= transform.get('y', 0) - interactionRadius.get('y', 0)
        && token.get('y', 101) <= transform.get('y', 0) + interactionRadius.get('y', 0)
        && validPlayerObjectTransition(
          type,
          resource.data.get('stateId', ''),
          request.resource.data.get('stateId', '')
        )
        && (
          type != 'door'
          || (
            request.resource.data.get('stateId', '') == 'closed'
            && request.resource.data.get('blocksMovement', false) == true
            && request.resource.data.get('blocksVision', false) == true
          )
          || (
            request.resource.data.get('stateId', '') == 'open'
            && request.resource.data.get('blocksMovement', true) == false
            && request.resource.data.get('blocksVision', true) == false
          )
        );
    }

    function validDmPuzzle(roomCode, puzzleId) {
      let runtime = request.resource.data.get('runtime', {});
      let triggers = request.resource.data.get('triggers', []);
      let actions = request.resource.data.get('actions', []);
      let resetActions = request.resource.data.get('resetActions', []);
      return request.resource.data.keys().hasOnly([
          'id', 'roomCode', 'name', 'description', 'enabled', 'hiddenState',
          'allowCrossFloor', 'triggerMode', 'triggers', 'actions', 'resetActions',
          'runtime', 'revision', 'createdByUid', 'updatedByUid',
          'createdAtMillis', 'updatedAtMillis', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('id', '') == puzzleId
        && request.resource.data.get('roomCode', '') == roomCode
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('enabled', null) is bool
        && request.resource.data.get('hiddenState', null) is bool
        && request.resource.data.get('allowCrossFloor', null) is bool
        && request.resource.data.get('triggerMode', '') in ['all', 'any', 'sequence']
        && triggers is list
        && triggers.size() > 0
        && triggers.size() <= 20
        && actions is list
        && actions.size() > 0
        && actions.size() <= 20
        && resetActions is list
        && resetActions.size() <= 40
        && runtime is map
        && runtime.keys().hasOnly([
          'status', 'sequenceIndex', 'executionId', 'lastObjectId',
          'solvedAtMillis', 'message'
        ])
        && runtime.get('status', '') in ['idle', 'progress', 'solved', 'error']
        && runtime.get('sequenceIndex', -1) is int
        && runtime.get('sequenceIndex', -1) >= 0
        && runtime.get('sequenceIndex', 21) <= 20
        && runtime.get('executionId', '') is string
        && runtime.get('executionId', '').size() <= 180
        && runtime.get('lastObjectId', '') is string
        && runtime.get('lastObjectId', '').size() <= 180
        && runtime.get('solvedAtMillis', -1) is number
        && runtime.get('solvedAtMillis', -1) >= 0
        && runtime.get('message', '') is string
        && runtime.get('message', '').size() <= 500
        && request.resource.data.get('revision', 0) is int
        && request.resource.data.get('revision', 0) >= 1
        && request.resource.data.get('createdByUid', '') is string
        && request.resource.data.get('updatedByUid', '') is string
        && request.resource.data.get('createdAtMillis', -1) is number
        && request.resource.data.get('updatedAtMillis', -1) is number;
    }

    function playerDrawingEnabled(roomCode) {
      return roomData(roomCode)
        .get('drawingSettings', {})
        .get('playersEnabled', false) == true;
    }

    function validWorkshopAssetType(value) {
      return value in [
        'monster', 'magic-item', 'spell', 'animation', 'npc',
        'map', 'encounter', 'summon', 'feat', 'other'
      ];
    }

    function validWorkshopVisibility(value) {
      return value in ['PRIVATE', 'ROOM', 'FRIENDS', 'PUBLIC'];
    }

    function canReadWorkshopAsset(data) {
      return signedIn()
        && (
          data.authorUid == request.auth.uid
          || data.visibility == 'PUBLIC'
          || (
            data.visibility == 'ROOM'
            && data.roomCode is string
            && isRoomMember(data.roomCode)
          )
        );
    }

    function validWorkshopSummary(assetId) {
      return request.resource.data.keys().hasOnly([
          'assetId', 'assetType', 'name', 'nameSearch', 'description',
          'authorUid', 'authorName', 'visibility', 'roomCode', 'tags',
          'thumbnailUrl', 'version', 'forkedFrom', 'sourceKey',
          'sourceType', 'sourceRecordId', 'typeMetadata',
          'collectionIds', 'saveCount', 'createdAt',
          'updatedAt', 'createdAtMillis', 'updatedAtMillis'
        ])
        && request.resource.data.assetId == assetId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && validWorkshopAssetType(request.resource.data.assetType)
        && request.resource.data.sourceType is string
        && request.resource.data.sourceType.size() <= 80
        && request.resource.data.typeMetadata is map
        && validWorkshopVisibility(request.resource.data.visibility)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 16
        && request.resource.data.thumbnailUrl is string
        && (
          request.resource.data.thumbnailUrl == ''
          || request.resource.data.thumbnailUrl.matches('https://.*')
        )
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 1000000
        && (
          request.resource.data.visibility != 'ROOM'
          || (
            request.resource.data.roomCode is string
            && isRoomMember(request.resource.data.roomCode)
          )
        );
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if isSelf(userId);

      match /rooms/{roomCode} {
        allow read, create, update, delete:
          if isSelf(userId);
      }

      match /animations/{animationId} {
        allow read, delete:
          if isSelf(userId);

        allow create, update:
          if isSelf(userId)
          && request.resource.data.get('id', '') == animationId
          && request.resource.data.get('ownerId', '') == userId
          && request.resource.data.get('ownership', {}).get('scope', '') == 'user'
          && request.resource.data.get('ownership', {}).get('ownerId', '') == userId
          && request.resource.data.get('sprite', '') is string
          && request.resource.data.get('sprite', '').matches('https://.*')
          && (
            request.resource.data.get('sound', null) == null
            || request.resource.data.get('sound', {}).get('src', '') == ''
            || request.resource.data.get('sound', {}).get('src', '').matches('https://.*')
          );
      }

      match /magicItems/{itemId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == itemId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.itemType in [
            'weapon', 'armor', 'consumable', 'wondrous-item'
          ]
          && request.resource.data.rarity in [
            'common', 'uncommon', 'rare', 'very-rare',
            'legendary', 'artifact', 'varies'
          ]
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 8000
          && request.resource.data.imageUrl is string
          && (
            request.resource.data.imageUrl == ''
            || request.resource.data.imageUrl.matches('https://.*')
          )
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 16
          && request.resource.data.effects is list
          && request.resource.data.effects.size() <= 30
          && request.resource.data.updatedAtMillis is number;
      }

      match /spells/{spellId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == spellId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.level is int
          && request.resource.data.level >= 0
          && request.resource.data.level <= 9
          && request.resource.data.school is string
          && request.resource.data.school.size() > 0
          && request.resource.data.school.size() <= 40
          && request.resource.data.classes is list
          && request.resource.data.classes.size() <= 20
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 12000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.animations is map
          && request.resource.data.updatedAtMillis is number;
      }

      match /npcs/{npcId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == npcId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.portraitUrl is string
          && (
            request.resource.data.portraitUrl == ''
            || request.resource.data.portraitUrl.matches('https://.*')
          )
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.size() <= 40
          && (
            request.resource.data.roomCode == ''
            || isRoomMember(request.resource.data.roomCode)
          )
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 8000
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 12000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 24
          && request.resource.data.relationshipIds is list
          && request.resource.data.relationshipIds.size() <= 100
          && request.resource.data.factionIds is list
          && request.resource.data.factionIds.size() <= 50
          && request.resource.data.knowledge is list
          && request.resource.data.knowledge.size() <= 100
          && request.resource.data.combat is map
          && request.resource.data.updatedAtMillis is number;
      }
      match /npcRelationships/{relationshipId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == relationshipId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.sourceNpcId is string
          && request.resource.data.sourceNpcId.size() > 0
          && request.resource.data.sourceNpcId.size() <= 160
          && request.resource.data.targetNpcId is string
          && request.resource.data.targetNpcId.size() > 0
          && request.resource.data.targetNpcId.size() <= 160
          && request.resource.data.sourceNpcId != request.resource.data.targetNpcId
          && request.resource.data.relationshipType in [
            'Friend', 'Ally', 'Enemy', 'Rival', 'Family', 'Lover',
            'Employer', 'Employee', 'Leader', 'Follower', 'Contact',
            'Knows', 'Distrusts', 'Owes', 'Custom'
          ]
          && request.resource.data.direction in ['directed', 'mutual']
          && request.resource.data.trust is number
          && request.resource.data.trust >= 0
          && request.resource.data.trust <= 100
          && request.resource.data.hostility is number
          && request.resource.data.hostility >= 0
          && request.resource.data.hostility <= 100
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 5000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.createdAtMillis is number
          && request.resource.data.updatedAtMillis is number;
      }


      match /encounters/{encounterId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == encounterId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 12000
          && request.resource.data.environment is string
          && request.resource.data.environment.size() <= 2000
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.size() <= 40
          && (
            request.resource.data.roomCode == ''
            || isRoomMember(request.resource.data.roomCode)
          )
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 24
          && (
            request.resource.data.mapRef == null
            || request.resource.data.mapRef is map
          )
          && request.resource.data.combatants is list
          && request.resource.data.combatants.size() <= 50
          && request.resource.data.lighting is map
          && request.resource.data.updatedAtMillis is number;
      }

      match /summons/{summonId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.id == summonId
          && request.resource.data.ownerUid == userId
          && validPersonalLibraryRevision(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.sourceLibraryId is string
          && request.resource.data.sourceLibraryId.size() <= 241
          && request.resource.data.source is map
          && request.resource.data.source.get('assetType', '') in [
            'monster', 'npc', 'character', 'custom'
          ]
          && request.resource.data.source.get('libraryId', '') is string
          && request.resource.data.source.get('sourceRecordId', '') is string
          && request.resource.data.count is int
          && request.resource.data.count >= 1
          && request.resource.data.count <= 20
          && request.resource.data.placement is map
          && request.resource.data.ownership is map
          && request.resource.data.initiative is map
          && request.resource.data.duration is map
          && request.resource.data.endBehavior is map
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.updatedAtMillis is number;
      }

      match /libraryIndex/{libraryId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.libraryId == libraryId
          && (
            request.resource.data.assetType == 'monster'
            || request.resource.data.assetType == 'map'
          )
          && request.resource.data.sourceRecordId is string
          && request.resource.data.sourceRecordId.size() > 0
          && request.resource.data.sourceRoomCode is string
          && request.resource.data.sourceRoomCode.size() > 0
          && request.resource.data.ownerUid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.updatedAtMillis is number;
      }

      match /workshopFavorites/{assetId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.assetId == assetId;
      }

      match /workshopImports/{assetId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /workshopCollections/{collectionId} {
        allow read, delete: if isSelf(userId);
        allow create, update:
          if isSelf(userId)
          && request.resource.data.collectionId == collectionId
          && request.resource.data.ownerUid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.assetIds is list
          && request.resource.data.assetIds.size() <= 500
          && request.resource.data.get('entries', []) is list
          && request.resource.data.get('entries', []).size() <= 500;
      }

      match /workshopLibrary/{recordId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /workshopAssets/{assetId} {
      allow read: if canReadWorkshopAsset(resource.data);

      allow create:
        if signedIn()
        && validWorkshopSummary(assetId);

      allow update:
        if signedIn()
        && (
          (
            resource.data.authorUid == request.auth.uid
            && validWorkshopSummary(assetId)
            && request.resource.data.version >= resource.data.version
            && request.resource.data.version <= resource.data.version + 1
          )
          || (
            resource.data.visibility == 'ROOM'
            && isRoomDm(resource.data.roomCode)
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.visibility == 'PRIVATE'
            && request.resource.data.roomCode == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'visibility', 'roomCode', 'updatedAt', 'updatedAtMillis'
            ])
          )
        );

      allow delete:
        if signedIn()
        && resource.data.authorUid == request.auth.uid;

      match /versions/{versionId} {
        allow read:
          if exists(/databases/$(database)/documents/workshopAssets/$(assetId))
          && canReadWorkshopAsset(
            get(/databases/$(database)/documents/workshopAssets/$(assetId)).data
          );

        allow create:
          if signedIn()
          && existsAfter(/databases/$(database)/documents/workshopAssets/$(assetId))
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.authorUid
            == request.auth.uid
          && request.resource.data.assetId == assetId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && versionId == string(request.resource.data.version)
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.version
            == request.resource.data.version
          && request.resource.data.content is map
          && request.resource.data.keys().hasOnly([
            'assetId', 'version', 'authorUid', 'createdAt',
            'createdAtMillis', 'content'
          ]);

        allow update:
          if signedIn()
          && existsAfter(/databases/$(database)/documents/workshopAssets/$(assetId))
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.authorUid
            == request.auth.uid
          && getAfter(/databases/$(database)/documents/workshopAssets/$(assetId)).data.version
            == resource.data.version
          && request.resource.data.assetId == resource.data.assetId
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.version == resource.data.version
          && versionId == string(resource.data.version)
          && request.resource.data.content is map
          && request.resource.data.keys().hasOnly([
            'assetId', 'version', 'authorUid', 'createdAt',
            'createdAtMillis', 'content'
          ]);

        allow delete:
          if signedIn()
          && exists(/databases/$(database)/documents/workshopAssets/$(assetId))
          && get(/databases/$(database)/documents/workshopAssets/$(assetId)).data.authorUid
            == request.auth.uid;
      }
    }

    match /rooms/{roomCode} {
      allow create:
        if signedIn()
        && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.roomCode == roomCode;

      allow read:
        if isRoomMember(roomCode);

      allow update:
        if (
          isRoomDm(roomCode)
          && request.resource.data.get('dmUid', resource.data.dmUid)
            == resource.data.dmUid
          && (
            roomAcceptsWrites(roomCode)
            || deletionLifecycleFieldsOnly()
          )
        )
        || validPlayerMovementRoomUpdate(roomCode)
        || validPlayerMovementModeRoomUpdate(roomCode)
        || validPlayerDashRoomUpdate(roomCode)
        || validPlayerTurnAdvanceRequest(roomCode);

      allow delete:
        if isRoomDm(roomCode);

      match /players/{playerUid} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if signedIn()
          && request.auth.uid == playerUid
          && roomExists(roomCode)
          && roomAcceptsWrites(roomCode)
          && request.resource.data.uid == request.auth.uid
          && (
            request.resource.data.role == 'player'
            || (
              isRoomDm(roomCode)
              && request.resource.data.role == 'dm'
            )
          );

        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isSelf(playerUid)
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.role == resource.data.role
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            isSelf(playerUid)
            && resource.data.uid == request.auth.uid
          );
      }

      match /activePlayers/{sessionId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sessionId == sessionId;

        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isRoomMember(roomCode)
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.sessionId == sessionId
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            signedIn()
            && resource.data.uid == request.auth.uid
          );
      }

      match /characters/{characterId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validCharacterWrite(roomCode)
          && request.resource.data.ownerUid == request.auth.uid;

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validCharacterWrite(roomCode)
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && (
            request.resource.data.ownerUid
              == resource.data.get('ownerUid', '')
            || (
              isRoomDm(roomCode)
              && resource.data.get('ownerUid', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
            )
          )
          && (
            ownsCharacter(resource.data)
            || isRoomDm(roomCode)
          );

        allow delete:
          if isRoomMember(roomCode)
          && (
            ownsCharacter(resource.data)
            || isRoomDm(roomCode)
          );
      }

      match /monsters/{monsterId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validDmOwnedWrite(roomCode)
          && request.resource.data.get('revision', 0) == 1;

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validDmOwnedWrite(roomCode)
          && request.resource.data.get('revision', 0)
            == resource.data.get('revision', 0) + 1
          && (
            request.resource.data.ownerUid
              == resource.data.get('ownerUid', '')
            || (
              resource.data.get('ownerUid', '') == ''
              && request.resource.data.ownerUid
                == roomData(roomCode).dmUid
            )
          );

        allow delete:
          if isRoomDm(roomCode)
          && (
            resource.data.get('ownerUid', '') == ''
            || resource.data.ownerUid
              == roomData(roomCode).dmUid
          );
      }

      match /animations/{animationId} {
        allow read:
          if isRoomMember(roomCode);

        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.get('id', '') == animationId
          && request.resource.data.get('roomCode', '') == roomCode
          && request.resource.data.get('ownerId', '') == roomCode
          && request.resource.data.get('ownership', {}).get('scope', '') == 'room'
          && request.resource.data.get('ownership', {}).get('ownerId', '') == roomCode
          && request.resource.data.get('sprite', '') is string
          && request.resource.data.get('sprite', '').matches('https://.*')
          && (
            request.resource.data.get('sound', null) == null
            || request.resource.data.get('sound', {}).get('src', '') == ''
            || request.resource.data.get('sound', {}).get('src', '').matches('https://.*')
          );

        allow delete:
          if isRoomDm(roomCode);
      }

      match /combatEffects/{effectId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && request.resource.data.get('id', '') == effectId
          && request.resource.data.get('roomCode', '') == roomCode
          && request.resource.data.get('createdByUid', '') == request.auth.uid;

        allow update:
          if roomAcceptsWrites(roomCode)
          && (
            isRoomDm(roomCode)
            || (
              isRoomMember(roomCode)
              && resource.data.get('createdByUid', '') == request.auth.uid
            )
          )
          && request.resource.data.get('id', '') == effectId
          && request.resource.data.get('roomCode', '') == roomCode
          && request.resource.data.get('createdByUid', '')
            == resource.data.get('createdByUid', '');

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.get('createdByUid', '') == request.auth.uid
          );
      }

      match /effects/{effectId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validGameplayEffect(roomCode, effectId);

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validGameplayEffect(roomCode, effectId)
          && request.resource.data.createdByUid
            == resource.data.createdByUid
          && request.resource.data.createdAtMillis
            == resource.data.createdAtMillis;

        allow delete:
          if isRoomDm(roomCode);
      }

      match /sharedJournal/{entryId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validJournalEntry(roomCode, entryId, 'shared')
          && (
            isRoomDm(roomCode)
            || request.resource.data.ownerUid == request.auth.uid
          );

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validJournalEntry(roomCode, entryId, 'shared')
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && (
            isRoomDm(roomCode)
            || resource.data.ownerUid == request.auth.uid
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.ownerUid == request.auth.uid
          );
      }

      match /personalJournal/{entryId} {
        allow read:
          if isRoomMember(roomCode)
          && resource.data.ownerUid == request.auth.uid;

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && validJournalEntry(roomCode, entryId, 'personal')
          && request.resource.data.ownerUid == request.auth.uid;

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && validJournalEntry(roomCode, entryId, 'personal');

        allow delete:
          if isRoomMember(roomCode)
          && resource.data.ownerUid == request.auth.uid;
      }

      match /dmJournal/{entryId} {
        allow read:
          if isRoomDm(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validJournalEntry(roomCode, entryId, 'dm');

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.revision
            == resource.data.get('revision', 0) + 1
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && validJournalEntry(roomCode, entryId, 'dm');

        allow delete:
          if isRoomDm(roomCode);
      }

      match /sharedDrawings/{strokeId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomMember(roomCode)
          && request.resource.data.authorUid == request.auth.uid
          && validDrawingStroke(roomCode, strokeId, 'shared')
          && (
            isRoomDm(roomCode)
            || playerDrawingEnabled(roomCode)
          );

        allow update:
          if false;

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.authorUid == request.auth.uid
            && playerDrawingEnabled(roomCode)
          );
      }

      match /dmDrawings/{strokeId} {
        allow read:
          if isRoomDm(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.authorUid == request.auth.uid
          && validDrawingStroke(roomCode, strokeId, 'dm');

        allow update:
          if false;

        allow delete:
          if isRoomDm(roomCode);
      }

      match /fogSettings/{mapId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.revision == 1
          && validFogSettings(roomCode, mapId);

        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.mapId == resource.data.mapId
          && (
            (
              request.resource.data.revision == resource.data.revision
              && request.resource.data.baseState == resource.data.baseState
            )
            || request.resource.data.revision == resource.data.revision + 1
          )
          && validFogSettings(roomCode, mapId);

        allow delete:
          if isRoomDm(roomCode);
      }

      match /fogOperations/{operationId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validFogOperation(roomCode, operationId);

        allow update:
          if false;

        allow delete:
          if isRoomDm(roomCode);
      }

      match /visionWalls/{wallId} {
        allow read:
          if isRoomMember(roomCode);

        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validVisionWall(roomCode, wallId);

        allow update:
          if false;

        allow delete:
          if isRoomDm(roomCode);
      }

      match /visionExploration/{explorationId} {
        allow read:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.ownerUid == request.auth.uid
          );

        allow create:
          if roomAcceptsWrites(roomCode)
          && validVisionExploration(roomCode)
          && (
            isRoomDm(roomCode)
            || request.resource.data.ownerUid == request.auth.uid
          );

        allow update:
          if roomAcceptsWrites(roomCode)
          && validVisionExploration(roomCode)
          && request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.mapId == resource.data.mapId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (
            isRoomDm(roomCode)
            || resource.data.ownerUid == request.auth.uid
          );

        allow delete:
          if isRoomDm(roomCode)
          || (
            isRoomMember(roomCode)
            && resource.data.ownerUid == request.auth.uid
          );
      }

      match /maps/{mapId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /scenes/{sceneId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validScene(roomCode, sceneId);
        allow delete:
          if isRoomDm(roomCode);

        match /floors/{floorId} {
          allow read:
            if isRoomMember(roomCode);
          allow create, update:
            if roomAcceptsWrites(roomCode)
            && isRoomDm(roomCode)
            && validFloor(roomCode, sceneId, floorId);
          allow delete:
            if isRoomDm(roomCode);
        }

        match /connections/{connectionId} {
          allow read:
            if isRoomMember(roomCode);
          allow create, update:
            if roomAcceptsWrites(roomCode)
            && isRoomDm(roomCode)
            && validFloorConnection(roomCode, sceneId, connectionId);
          allow delete:
            if isRoomDm(roomCode);
        }

        match /dmFloorNotes/{floorId} {
          allow read:
            if isRoomDm(roomCode);
          allow create, update:
            if roomAcceptsWrites(roomCode)
            && isRoomDm(roomCode)
            && request.resource.data.keys().hasOnly([
              'floorId', 'sceneId', 'roomCode', 'notes',
              'updatedAtMillis', 'updatedAt'
            ])
            && request.resource.data.get('floorId', '') == floorId
            && request.resource.data.get('sceneId', '') == sceneId
            && request.resource.data.get('roomCode', '') == roomCode
            && request.resource.data.get('notes', '') is string
            && request.resource.data.get('notes', '').size() <= 12000
            && request.resource.data.get('updatedAtMillis', -1) is number;
          allow delete:
            if isRoomDm(roomCode);
        }
      }

      match /puzzleTiles/{tileId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /tokens/{tokenId} {
        allow read:
          if isRoomMember(roomCode);
        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && tokenIsShared(request.resource.data);
        allow delete:
          if isRoomDm(roomCode);
        allow update:
          if roomAcceptsWrites(roomCode)
          && tokenIsShared(request.resource.data)
          && (
            isRoomDm(roomCode)
            || (
              isRoomMember(roomCode)
              && resource.data.get('ownerUid', '') == request.auth.uid
              && request.resource.data.get('ownerUid', '')
                == resource.data.get('ownerUid', '')
              && (
                (
                  tokenMovementFieldsOnly()
                  && tokenIsCurrentOrExploring(roomCode, tokenId)
                  && trackedTokenMoveIsConfirmed(roomCode, tokenId)
                )
                || validPlayerFloorTransition(roomCode, tokenId)
                || validLinkedCharacterTokenSync(roomCode)
              )
            )
          );
      }

      match /dmTokens/{tokenId} {
        allow read:
          if isRoomDm(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && tokenIsDmOnly(request.resource.data);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /objects/{objectId} {
        allow read:
          if isRoomMember(roomCode);
        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validMapObject(roomCode, objectId, 'shared');
        allow update:
          if (
            roomAcceptsWrites(roomCode)
            && isRoomDm(roomCode)
            && validMapObject(roomCode, objectId, 'shared')
          )
          || validPlayerMapObjectInteraction(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /dmObjects/{objectId} {
        allow read:
          if isRoomDm(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validMapObject(roomCode, objectId, 'dm');
        allow delete:
          if isRoomDm(roomCode);
      }

      match /dmPuzzles/{puzzleId} {
        allow read:
          if isRoomDm(roomCode);
        allow create:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validDmPuzzle(roomCode, puzzleId)
          && request.resource.data.get('revision', 0) == 1
          && request.resource.data.get('createdByUid', '') == request.auth.uid;
        allow update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode)
          && validDmPuzzle(roomCode, puzzleId)
          && request.resource.data.get('revision', 0) == resource.data.get('revision', 0) + 1
          && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '');
        allow delete:
          if isRoomDm(roomCode);
      }

      match /combatTurns/{tokenId} {
        allow read:
          if isRoomMember(roomCode);
        allow create:
          if validCombatTurnCreate(roomCode, tokenId);
        allow update:
          if validCombatTurnUpdate(roomCode, tokenId);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /classes/{classId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /species/{speciesId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /backgrounds/{backgroundId} {
        allow read:
          if isRoomMember(roomCode);
        allow create, update:
          if roomAcceptsWrites(roomCode)
          && isRoomDm(roomCode);
        allow delete:
          if isRoomDm(roomCode);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
